{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "--no-install",
        "chrome-devtools-mcp",
        "--headless",
        "--isolated",
        "--viewport=1440x900",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      },
      "enabled": true
    }
  }
}
